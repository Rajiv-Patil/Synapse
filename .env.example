# Local PostgreSQL credentials
POSTGRES_DB=synapse
POSTGRES_USER=synapse_app
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Public UI port
FRONTEND_PORT=5174
APP_FRONTEND_REDIRECT_URL=http://localhost:5174/chat

# CORS: add your deployed domain here (comma-separated) alongside localhost
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Cognito OAuth (required for sign-in)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# Optional LLM provider keys
GROQ_API_KEY=
HUGGING_FACE_API_KEY=

# Redis caching: each service gets its own container (redis-conversation, redis-dataset,
# redis-ai), wired automatically in compose.yaml. No manual configuration needed locally.


